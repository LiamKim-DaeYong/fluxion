{
  "uid": "fluxion-overview",
  "title": "Fluxion Overview",
  "description": "JVM, HTTP (RED), and HikariCP panels for Fluxion. Metric names follow Spring Boot Actuator / Micrometer Prometheus output.",
  "tags": ["fluxion", "spring-boot", "jvm"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(jvm_info,application)",
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_info,application)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(jvm_info{application=\"$application\"},instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_info{application=\"$application\"},instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "JVM",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "description": "Drops to zero when the JVM restarts.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 0 },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_uptime_seconds{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Heap used / max",
      "description": "Heap pool sum. G1 reports max=-1 for Eden and Survivor, so max only sums pools with a defined limit.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 7, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance) (jvm_memory_used_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"})",
          "legendFormat": "used {{instance}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance) (jvm_memory_max_bytes{application=\"$application\", instance=~\"$instance\", area=\"heap\"} > 0)",
          "legendFormat": "max {{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GC pause",
      "description": "Average and max stop-the-world pause per GC action. Micrometer registers jvm_gc_pause_seconds after the first GC event.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 7, "x": 11, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance, action) (rate(jvm_gc_pause_seconds_sum{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])) / sum by (instance, action) (rate(jvm_gc_pause_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "avg {{action}} {{instance}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (instance, action) (jvm_gc_pause_seconds_max{application=\"$application\", instance=~\"$instance\"})",
          "legendFormat": "max {{action}} {{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Threads",
      "description": "Platform threads. Virtual thread meters need io.micrometer:micrometer-java21 on the classpath.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_live_threads{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "live {{instance}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_daemon_threads{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "daemon {{instance}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_threads_peak_threads{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "peak {{instance}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "HTTP",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Requests per second by method, uri, and status. Includes Prometheus scrapes of /actuator/prometheus.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance, method, uri, status) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "Needs management.metrics.distribution.percentiles-histogram.http.server.requests=true to publish _bucket series.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, instance, uri) (rate(http_server_requests_seconds_bucket{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{uri}} {{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "5xx error ratio",
      "description": "Share of requests answered with 5xx. Shows 0 instead of no data while there are no 5xx responses.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum by (instance) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\", status=~\"5..\"}[$__rate_interval])) or sum by (instance) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval])) * 0) / sum by (instance) (rate(http_server_requests_seconds_count{application=\"$application\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Database",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HikariCP connections",
      "description": "Active, idle, and pending (threads waiting for a connection) against the pool max.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "decimals": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "active {{pool}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_idle{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "idle {{pool}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_pending{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "pending {{pool}}"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_max{application=\"$application\", instance=~\"$instance\"}",
          "legendFormat": "max {{pool}}"
        }
      ]
    }
  ]
}
